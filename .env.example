# Copy to .env.local for local development. On Vercel, set these in Project Settings.
# Nothing is sent or charged unless DRY_RUN=0 AND live mode is enabled in the portal.

APP_URL=https://intheanswer.ca
APP_SECRET=                      # long random string: signs unsubscribe links (never rotate casually)
CRON_SECRET=                     # long random string: protects /api/cron/worker
DRY_RUN=1                        # 0 only when going live

# Owner details: used in every email and report footer. Live sending is refused while any is a placeholder.
OWNER_NAME="[FULL NAME]"
OWNER_BUSINESS_NAME="[REGISTERED BUSINESS NAME]"
OWNER_MAILING_ADDRESS="[MAILING ADDRESS]"
OWNER_PHONE="[PHONE]"
OWNER_CONTACT_EMAIL=hello@intheanswer.ca
MONTHLY_MIN_TERM_MONTHS="[MINIMUM TERM]"   # full service plan contract, in months (e.g. 12)
REPORTS_MIN_TERM_MONTHS=3                    # monthly reports plan minimum term, in months
OWNER_EMAIL=hello@intheanswer.ca # the only account allowed into the portal

# Supabase
DATABASE_URL=                    # Supabase > Connect > Transaction pooler (port 6543), role postgres
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # server only (storage uploads)
SUPABASE_STORAGE_BUCKET=reports

# Claude API (analysis, with web search)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Google Places API (New): discovery, place_id lookups, live review numbers on the web report.
# Only place_id is ever stored (Google Maps Platform terms); ratings/counts are fetched live.
GOOGLE_PLACES_API_KEY=

# PageSpeed Insights API (site test speed + real-visitor Core Web Vitals). Optional:
# without it a local Lighthouse lab test is run instead (lab numbers only).
PAGESPEED_API_KEY=

# Google Business Profile (monthly clients connect their own profile for review analysis).
# OAuth client of type "Web application"; redirect URI: {APP_URL}/connect/google/callback
# The Business Profile APIs must be enabled and approved for the Google Cloud project.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Email provider: Resend. Cold mail goes out from the mail. subdomain so the main mailbox keeps its own
# reputation. Point MAIL_REPLY_TO at an address on the Resend receiving domain so replies reach the portal.
MAIL_FROM=hello@mail.intheanswer.ca
MAIL_FROM_NAME=
MAIL_REPLY_TO=hello@intheanswer.ca
SENDING_DOMAIN=mail.intheanswer.ca
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_DOMAIN_ID=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ONE_TIME=           # 200 CAD one-time price id
STRIPE_PRICE_MONTHLY=            # 200 CAD / month recurring price id
STRIPE_PRICE_REPORTS_MONTHLY=      # monthly reports: 50 CAD / month recurring price id
STRIPE_PRICE_REPORTS_FIRST=        # monthly reports: 100 CAD one-time price id, added to the first month (150 in total)
STRIPE_TAX_RATE_ID=              # optional: exclusive 13% HST tax rate id (txr_...), added on top of 200 CAD

# Local only
# PORTAL_DEV_BYPASS=1            # opens the portal without Supabase Auth (ignored in production)
# CHROME_PATH=/usr/bin/chromium  # PDF rendering locally
# EXTERNAL_MODE=live             # live | record | replay (fixtures for tests and demos)
